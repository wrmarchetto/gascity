#!/usr/bin/env bash

set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: scripts/with-go-tmp <command> [args...]" >&2
  exit 2
fi

# Go leaves per-build go-build*/go-link* directories behind when its parent is
# interrupted. Keep those children below one gate-owned directory on disk, not
# the shared /var/tmp root, so the cleanup trap can remove every remnant.
gotmpdir_val="$(mktemp -d -p /var/tmp gc-gotmp.XXXXXX)"
child_pid=""

# Both handlers below are reached only through the trap lines that follow
# them, which shellcheck does not count as a call site.
# shellcheck disable=SC2329  # invoked by `trap cleanup EXIT`
cleanup() {
  local status=$?
  trap - EXIT
  rm -rf "$gotmpdir_val"
  exit "$status"
}

# shellcheck disable=SC2329  # invoked by the INT and TERM traps below
terminate() {
  local signal=$1 status=$2
  if [[ -n "$child_pid" ]]; then
    kill -s "$signal" "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
  exit "$status"
}

trap cleanup EXIT
trap 'terminate INT 130' INT
trap 'terminate TERM 143' TERM

GOTMPDIR="$gotmpdir_val" "$@" &
child_pid=$!
# Score the wait explicitly. The obvious `if wait "$child_pid"; then exit 0;
# fi; exit $?` reads as an exit-status passthrough and is not one: a bash `if`
# whose condition is FALSE and which has no else branch is itself a SUCCESS,
# so by the time `exit $?` runs, `$?` is the compound's 0 rather than the
# child's status. That silently turned `make test` into a no-op gate -- the
# inner runner printed its own FAIL line and full failure details while make
# exited 0. Pinned by TestWithGoTmpPropagatesChildExitStatus.
#
# `|| status=$?` rather than a bare `wait`: this script runs under `set -e`,
# where a bare failing wait would abort into the EXIT trap and reach the same
# answer only by way of the trap's own status capture. The list form keeps the
# status the value of an assignment nobody has to trace.
status=0
wait "$child_pid" || status=$?
exit "$status"
