#!/usr/bin/env bash
set -euo pipefail

# Heavy `go test` fan-out runs here, at push time, instead of on every commit
# (#3628). pre-commit previously invoked `make test-fast-parallel` on every
# commit. Its outer shard fan-out can compile ~2.8 GiB test binaries per job,
# so the canonical runner now derives concurrency from both CPU and available
# memory while preserving an explicit LOCAL_TEST_JOBS override.
#
# The suite is also SCOPED to what the push can affect (ci-4w2t). This hook
# used to reduce the pushed range to one boolean -- "did any *.go file
# change" -- and then spend ~16 minutes on 187 packages answering it, the
# same price for a one-line fix as for a refactor. scripts/push-gate-select
# turns the same range into the package set the change can actually reach.
# It decides `full` on every uncertainty, so the failure mode of the whole
# mechanism is a slow push, never a skipped test.
#
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref
# on stdin (see githooks(5)). Read it ONCE, here: the ownership guard and the
# scope selector both need it, and stdin cannot be consumed twice.

zero="0000000000000000000000000000000000000000"

push_records="$(cat)"

any_non_deletion=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "$local_sha" ] || continue
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  any_non_deletion=1
done <<<"$push_records"

# Bead ownership/staleness guard (ga-fip9ps.1): re-checks bd claim state
# immediately before this push leaves the machine, once per invocation
# (not per ref) regardless of whether Go sources changed. A mayor ruling
# (reassign/close/hold/reroute) that landed after this push was queued
# must not be allowed to clobber a branch another agent has since taken
# over. Bypass: `git push --no-verify`.
#
# Deliberately ahead of the scope selection and outside every branch of it:
# a scoped run must never be a reason this guard did not fire.
if [ "$any_non_deletion" -eq 1 ]; then
  repo_root="$(git rev-parse --show-toplevel)"
  # shellcheck source=../scripts/push-ownership-guard.sh disable=SC1091
  . "$repo_root/scripts/push-ownership-guard.sh"
  if ! assert_bead_still_claimed; then
    exit 1
  fi
fi

if [ "$any_non_deletion" -eq 0 ]; then
  exit 0
fi

repo_root="${repo_root:-$(git rev-parse --show-toplevel)}"

# A selector that crashes, is missing, or prints anything unrecognized must
# read as "full", never as "nothing to run" -- hence the `|| true` and the
# catch-all branch below rather than a `set -e` abort.
# stderr is left attached so the reason a push widened to the full suite is
# visible to whoever is waiting on it.
decision="$(printf '%s\n' "$push_records" | "$repo_root/scripts/push-gate-select" || true)"

case "$decision" in
  none)
    echo "pre-push: no Go build inputs changed; skipping the fast suite"
    exit 0
    ;;
  scoped\ *)
    scope="${decision#scoped }"
    package_count="$(printf '%s\n' "$scope" | wc -w | tr -d ' ')"
    echo "pre-push: scoped fast suite to ${package_count} package(s)"
    # The Makefile and direct sharded runner share scripts/test-local-job-count
    # as their default policy. Do not shadow it here; an explicit override
    # still wins.
    GC_SCOPED_TEST_PACKAGES="$scope" exec make test-fast-parallel
    ;;
  full)
    exec make test-fast-parallel
    ;;
  *)
    echo "pre-push: unrecognized scope decision; running the full fast suite" >&2
    exec make test-fast-parallel
    ;;
esac
