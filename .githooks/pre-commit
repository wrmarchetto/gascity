#!/usr/bin/env bash
set -euo pipefail

# Inputs the generated TS API client is built from. Same set dashboard-ci
# hands scripts/check-artifact-drift.sh as --source for that artifact, and
# the hook cannot read that recipe, so the two copies are bound by
# TestPreCommitRegeneratesClientForEveryDeclaredClientSource instead --
# declaring a fourth --source without adding it here fails that test.
# Keying regeneration on the spec alone let a commit that only retuned
# openapi-ts.config.ts, or bumped the generator in package-lock.json, ship a
# client built by the OLD inputs with nothing catching it before CI's drift
# gate (ci-padp).
dashboard_client_sources=(
  'internal/api/openapi.json'
  'internal/api/dashboardspa/web/openapi-ts.config.ts'
  'internal/api/dashboardspa/web/package-lock.json'
)

staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)
# The whole SPA workspace, not an enumeration of its source dirs and configs.
# The enumeration this replaced drifted behind the tree: it missed
# eslint.config.mjs, prettier.config.mjs and .prettierignore -- so the files
# CONFIGURING lint and format were the ones whose changes got no lint or
# format check -- plus openapi-ts.config.ts, package-lock.json, the
# tailwind/postcss/vitest/playwright configs and all of frontend/e2e
# (ci-padp). Nothing tracked under web/ is prose or fixture data, so the
# directory is the correct trigger and a new config file joins it for free.
# Coverage is pinned by TestPreCommitSPAGateCoversEverySPASourceFile.
staged_web_src=$(git diff --cached --name-only --diff-filter=ACM -- 'internal/api/dashboardspa/web/' || true)
staged_docs=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' 'docs/**' 'engdocs/**' 'plans/**' 'specs/**' 'AGENTS.md' 'CONTRIBUTING.md' 'README.md' 'TESTING.md' || true)
staged_client_src=$(git diff --cached --name-only --diff-filter=ACM -- "${dashboard_client_sources[@]}" || true)

if [ -z "$staged_go_files" ] && [ -z "$staged_web_src" ] && [ -z "$staged_docs" ] && [ -z "$staged_client_src" ]; then
  exit 0
fi

if [ -n "$staged_go_files" ]; then
  printf '%s\n' "$staged_go_files" | scripts/precommit-format-staged-go
  printf '%s\n' "$staged_go_files" | xargs git add

  make lint-changed LINT_CHANGED_SCOPE=staged LINT_FLAGS="--new-from-rev=HEAD --whole-files --fix" || exit 1
  printf '%s\n' "$staged_go_files" | xargs git add

  # Regenerate the OpenAPI spec from the live Huma API and stage both
  # canonical copies. Keeps the committed spec and the published
  # Mintlify schema in lockstep with whatever the server actually
  # serves.
  go run ./cmd/genspec
  git add internal/api/openapi.json docs/reference/schema/openapi.json docs/reference/schema/openapi.txt

  go generate ./internal/api/genclient
  git add internal/api/genclient/client_gen.go

  # Regenerate the config/schema docs derived from Go structs and
  # stage every generated artifact so commits do not leave the
  # worktree dirty.
  go run ./cmd/genschema
  git add docs/reference/schema/city-schema.json docs/reference/schema/city-schema.txt docs/reference/config.md docs/reference/cli.md

  make vet
  # Heavy `go test` fan-out runs in .githooks/pre-push, not here (#3628).
  # Invoking `make test-fast-parallel` on every commit fired an
  # `xargs -P<nproc>` storm of ~2.8 GB test-binary compiles (~17 GB pressure,
  # load >100 on constrained hosts such as WSL). Format, lint, vet, and codegen
  # stay in pre-commit; the test suite gates at push time instead.
fi

if [ -n "$staged_docs" ]; then
  make check-docs
fi

# Re-read the index rather than reusing the pre-hook staged_client_src
# snapshot: the Go block above runs `go run ./cmd/genspec` and stages the
# regenerated internal/api/openapi.json, so a Go-only commit that moves the
# API surface only shows up here (#4627, #4607). Shared by both branches
# below so the npm-absent fail-closed branch sees the same side effect the
# npm-present branch already accounts for (ga-jg89a5) -- the branches must
# not diverge on which snapshot of "is a client input staged" they trust.
client_src_changed=$(git diff --cached --name-only --diff-filter=ACM -- "${dashboard_client_sources[@]}" || true)

# Dashboard SPA rebuild: when any generated-client input changes, regenerate
# the TS API client from it and stage the result. When a client input OR any
# SPA source changes, typecheck and rebuild the compiled bundle.
# Guarded on `npm` availability so contributors without Node tooling aren't
# blocked; CI enforces the full regeneration via make dashboard-ci.
if command -v npm >/dev/null 2>&1; then
  if [ -n "$client_src_changed" ]; then
    # Regenerate BEFORE typecheck/build below: a client that no longer
    # matches the new spec must fail typecheck immediately instead of
    # silently building/committing a stale client (#4627, #4607).
    (cd internal/api/dashboardspa/web && npm ci --silent && npm run generate:client)
    git add internal/api/dashboardspa/web/shared/src/generated/gc-supervisor-client
  fi
  if [ -n "$client_src_changed" ] || [ -n "$staged_web_src" ]; then
    # Typecheck BEFORE build: vite's build transpiles TS to JS and
    # silently ignores type errors. The Makefile target also runs the
    # Vitest suite, builds dist/, and smoke-runs the compiled SPA via
    # Vite preview so a bundle that builds but won't serve is caught
    # before CI.
    make dashboard-check dashboard-smoke
    git add internal/api/dashboardspa/dist
  fi
else
  if [ -n "$client_src_changed" ]; then
    echo "error: a generated-client input is staged but npm is not on PATH -- the generated TS API client" >&2
    echo "cannot be regenerated, so this commit would ship a stale client with no enforcement until CI runs." >&2
    echo "staged inputs:" >&2
    # A bash loop rather than `sed`: this branch's whole job is to name the
    # remedy, and it must survive a PATH holding nothing but git and bash.
    while IFS= read -r staged_client_input; do
      echo "  $staged_client_input" >&2
    done <<<"$client_src_changed"
    echo "Install Node/npm, or regenerate manually:" >&2
    echo "  cd internal/api/dashboardspa/web && npm ci && npm run generate:client" >&2
    exit 1
  fi
  echo "warning: npm not on PATH — skipped dashboard SPA typecheck + rebuild. CI will enforce this." >&2
fi
