-func commentOutYamlKey(content, key string) string {
+// commentOutYamlKey comments out every line binding key and reports whether it
+// matched anything. It handles BOTH spellings the writers emit for a dotted
+// key: the flat top-level line (`sync.remote: x`) and the nested path (`sync:`
+// with an indented `remote: x`). updateNestedYamlKey picks between them from
+// the state of the file at write time, so which one a given key wears is not
+// knowable here; matching only the flat one made `bd config unset sync.remote`
+// a silent no-op on every key that had been set into a non-empty config.yaml.
+//
+// Both spellings are commented rather than stopping at the first hit. A file
+// can legally carry the same key in each form, viper resolves that to the flat
+// one, and leaving either live means the value survives an unset.
+//
+// The nested arm resolves the path structurally instead of widening the regex
+// to the leaf name: `^(\s*)remote\s*:` would also match `remote:` under any
+// other parent, so unsetting sync.remote could clear an unrelated key.
+func commentOutYamlKey(content, key string) (string, bool) {
+	// strings.Split, not bufio.Scanner: Scanner drops the terminal newline, so
+	// the old implementation stripped it from a git-TRACKED file on every
+	// unset, and its default 64 KiB token cap silently truncated the rest of
+	// the file past an over-long line with no error path to notice.
+	lines := strings.Split(content, "\n")
+
+	commented := make(map[int]bool)
 	keyPattern := regexp.MustCompile(`^(\s*)` + regexp.QuoteMeta(key) + `\s*:`)
-
-	var result []string
-	scanner := bufio.NewScanner(strings.NewReader(content))
-	for scanner.Scan() {
-		line := scanner.Text()
+	for i, line := range lines {
 		if keyPattern.MatchString(line) {
-			matches := keyPattern.FindStringSubmatch(line)
-			indent := ""
-			if len(matches) > 1 {
-				indent = matches[1]
-			}
-			// Comment out the line, preserving indentation
-			result = append(result, indent+"# "+strings.TrimLeft(line, " \t"))
-		} else {
-			result = append(result, line)
+			commented[i] = true
+		}
+	}
+	for _, i := range nestedYamlKeyLines(lines, key) {
+		commented[i] = true
+	}
+
+	for i := range lines {
+		if !commented[i] {
+			continue
+		}
+		trimmed := strings.TrimLeft(lines[i], " \t")
+		// Blank lines inside a commented-out block stay blank; prefixing them
+		// would add "# " noise to lines that bind nothing.
+		if trimmed == "" {
+			continue
+		}
+		indent := lines[i][:len(lines[i])-len(trimmed)]
+		lines[i] = indent + "# " + trimmed
+	}
+
+	return strings.Join(lines, "\n"), len(commented) > 0
+}
+
+// nestedYamlKeyLines returns the 0-based indices of the lines carrying key
+// written as a nested path, spanning the key line and its whole value block. It
+// returns nil when the key is absent in that form, when the path runs through a
+// non-mapping, or when the content does not parse -- in each case the flat arm
+// of commentOutYamlKey is the only one that can match, which is the behavior
+// this function replaced.
+//
+// The value block matters because a leaf need not be a scalar: commenting out
+// only the `dolt:` line of a `dolt:` mapping would reparent its children and
+// leave the file unparseable.
+func nestedYamlKeyLines(lines []string, key string) []int {
+	if !strings.Contains(key, ".") {
+		return nil
+	}
+
+	var root yaml.Node
+	if err := yaml.Unmarshal([]byte(strings.Join(lines, "\n")), &root); err != nil {
+		return nil
+	}
+	if len(root.Content) == 0 {
+		return nil
+	}
+	mapping := root.Content[0]
+	if mapping.Kind != yaml.MappingNode {
+		return nil
+	}
+
+	var keyNode *yaml.Node
+	current := mapping
+	parts := strings.Split(key, ".")
+	for i, part := range parts {
+		if current.Kind != yaml.MappingNode {
+			return nil
+		}
+		idx := findMappingChild(current, part)
+		if idx == -1 {
+			return nil
+		}
+		if i == len(parts)-1 {
+			keyNode = current.Content[idx]
+			break
+		}
+		current = current.Content[idx+1]
+	}
+	if keyNode == nil {
+		return nil
+	}
+
+	// yaml.Node positions are 1-based.
+	start := keyNode.Line - 1
+	if start < 0 || start >= len(lines) {
+		return nil
+	}
+	indent := keyNode.Column - 1
+
+	// The block runs to the last following line indented deeper than the key.
+	// Blank lines neither end it nor extend it, so a blank line before the next
+	// sibling is left outside the range.
+	end := start
+	for i := start + 1; i < len(lines); i++ {
+		trimmed := strings.TrimLeft(lines[i], " \t")
+		if trimmed == "" {
+			continue
 		}
+		if len(lines[i])-len(trimmed) <= indent {
+			break
+		}
+		end = i
 	}
 
-	return strings.Join(result, "\n")
+	out := make([]int, 0, end-start+1)
+	for i := start; i <= end; i++ {
+		out = append(out, i)
+	}
+	return out
 }
 
