+// clearSyncRemoteFromConfig drops sync.remote from config.yaml after the origin
+// Dolt remote is removed, and commits the file only if that actually changed
+// something.
+//
+// The commit is gated on the removal because sync.remote is a PUSH TARGET in a
+// git-tracked file. When the unset matched nothing, the old code still ran
+// commitBeadsConfig("bd: clear sync.remote") -- landing a commit whose message
+// says the remote was cleared on top of a file that still names it, and
+// propagating that to every clone. A warning naming the file is the honest
+// outcome: the caller has already confirmed the key is set, so reaching this
+// branch means the writer could not find the spelling it is stored in.
+//
+// Shared with the proxied-server path (dolt_remote_proxied_server.go); the two
+// had drifted into byte-identical copies of this sequence.
+func clearSyncRemoteFromConfig() {
+	removed, err := config.UnsetYamlConfig("sync.remote")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Warning: failed to clear sync.remote from config.yaml: %v\n", err)
+		return
+	}
+	if !removed {
+		fmt.Fprintf(os.Stderr, "Warning: sync.remote is set but was not found in config.yaml; "+
+			"the push target is still configured. Remove it by hand, then verify with "+
+			"'bd config get sync.remote'.\n")
+		return
+	}
+	if isGitRepo() {
+		commitBeadsConfig("bd: clear sync.remote")
+	}
+}
