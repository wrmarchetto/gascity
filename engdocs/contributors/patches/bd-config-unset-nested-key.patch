+// yamlKeyStillBound reports whether a dotted key still resolves to a value in
+// the given config.yaml text, accepting EITHER spelling the writers can emit:
+// the flat top-level `sync.remote:` line and the nested `sync:` / `  remote:`
+// path.
+//
+// It parses the YAML directly instead of calling GetYamlConfig so the assertion
+// cannot inherit the lookup bug it exists to catch: the whole defect was that
+// one half of the code knew about only one spelling. A checker that consulted
+// the same production helper as the writer would agree with it and pass.
+func yamlKeyStillBound(t *testing.T, content, key string) bool {
+	t.Helper()
+	var root map[string]interface{}
+	if err := yaml.Unmarshal([]byte(content), &root); err != nil {
+		t.Fatalf("config.yaml is not parseable YAML after unset: %v\n%s", err, content)
+	}
+	if _, ok := root[key]; ok {
+		return true
+	}
+	var node interface{} = root
+	for _, part := range strings.Split(key, ".") {
+		m, ok := node.(map[string]interface{})
+		if !ok {
+			return false
+		}
+		node, ok = m[part]
+		if !ok {
+			return false
+		}
+	}
+	return node != nil
+}
