+// withProjectConfigYaml creates a temp project whose .beads/config.yaml holds
+// the given content, points config resolution at it, and returns the project
+// root. BEADS_DIR is cleared so resolution walks up from CWD, matching how the
+// operator's shell reaches the file.
+func withProjectConfigYaml(t *testing.T, content string) string {
+	t.Helper()
+	t.Setenv("BEADS_DIR", "")
+
+	dir := t.TempDir()
+	beadsDir := filepath.Join(dir, ".beads")
+	if err := os.MkdirAll(beadsDir, 0755); err != nil {
+		t.Fatalf("Failed to create .beads dir: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(beadsDir, "config.yaml"), []byte(content), 0644); err != nil {
+		t.Fatalf("Failed to write config.yaml: %v", err)
+	}
+
+	oldWd, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("Failed to get working directory: %v", err)
+	}
+	if err := os.Chdir(dir); err != nil {
+		t.Fatalf("Failed to chdir: %v", err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(oldWd) })
+
+	return dir
+}
