+// TestUnsetYamlConfigRemovesWhatSetYamlConfigWrote pins the round trip for
+// dotted keys: after SetYamlConfig then UnsetYamlConfig, the key must no longer
+// be bound in config.yaml.
+//
+// The test drives the real writers rather than asserting a fixed file layout,
+// because the layout is precisely what diverged. setYamlConfigAtPath routes a
+// dotted key through updateNestedYamlKey and writes `sync:` / `  remote: x`,
+// while commentOutYamlKey only ever matched a flat `sync.remote:` line -- so
+// unset rewrote the file unchanged and still reported success. Asserting on the
+// nested layout instead would pin today's spelling and go green again the day
+// the writer switches back to flat, which is the one thing this must not do.
+//
+// sync.remote is the exemplar and the reason this matters beyond tidiness: it
+// is the Dolt PUSH TARGET, `bd dolt remote remove origin` clears it through
+// this same UnsetYamlConfig (cmd/bd/dolt.go), and on the nested spelling that
+// path went on to `commitBeadsConfig("bd: clear sync.remote")` -- committing
+// the still-populated file, to a git-TRACKED config, with a message saying the
+// remote was cleared.
+func TestUnsetYamlConfigRemovesWhatSetYamlConfigWrote(t *testing.T) {
+	keys := []struct {
+		key   string
+		value string
+	}{
+		{"sync.remote", "git+ssh://git@example.com/foo/bar.git"},
+		{"dolt.local-only", "true"},
+		{"backup.enabled", "false"},
+	}
+
+	for _, tc := range keys {
+		t.Run(tc.key, func(t *testing.T) {
+			dir := withProjectConfigYaml(t, "# Beads Config\nother-setting: value\n")
+			configPath := filepath.Join(dir, ".beads", "config.yaml")
+
+			if err := SetYamlConfig(tc.key, tc.value); err != nil {
+				t.Fatalf("SetYamlConfig(%q) error = %v", tc.key, err)
+			}
+			written, err := os.ReadFile(configPath)
+			if err != nil {
+				t.Fatalf("Failed to read config.yaml: %v", err)
+			}
+			if !yamlKeyStillBound(t, string(written), tc.key) {
+				t.Fatalf("SetYamlConfig(%q) did not bind the key; the round trip is untestable:\n%s", tc.key, written)
+			}
+
+			removed, err := UnsetYamlConfig(tc.key)
+			if err != nil {
+				t.Fatalf("UnsetYamlConfig(%q) error = %v", tc.key, err)
+			}
+			if !removed {
+				t.Errorf("UnsetYamlConfig(%q) reported the key was not set, want removed", tc.key)
+			}
+			cleared, err := os.ReadFile(configPath)
+			if err != nil {
+				t.Fatalf("Failed to read config.yaml: %v", err)
+			}
+			if yamlKeyStillBound(t, string(cleared), tc.key) {
+				t.Errorf("UnsetYamlConfig(%q) reported success but the key is still bound:\n%s", tc.key, cleared)
+			}
+			if !strings.Contains(string(cleared), "other-setting: value") {
+				t.Errorf("UnsetYamlConfig(%q) disturbed unrelated keys:\n%s", tc.key, cleared)
+			}
+		})
+	}
+}
