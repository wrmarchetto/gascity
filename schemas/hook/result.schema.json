{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc hook --claim --json result",
  "description": "One JSON record describing the routed-work claim result for a session startup hook.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "command",
    "action",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "ok": {
      "const": true
    },
    "command": {
      "const": "hook"
    },
    "action": {
      "enum": [
        "work",
        "drain"
      ]
    },
    "reason": {
      "enum": [
        "claimed",
        "existing_assignment",
        "ready_assignment",
        "no_work",
        "claims_errored",
        "stale_session"
      ]
    },
    "bead_id": {
      "type": "string"
    },
    "assignee": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "root_bead_id": {
      "type": "string"
    },
    "continuation_group": {
      "type": "string"
    },
    "continuation_assigned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drain_acknowledged": {
      "type": "boolean"
    },
    "sibling_branches": {
      "description": "Unlanded local branches already naming this bead or a bead sharing one of its labels, described from the claiming worktree's HEAD. Advisory: present only when such a branch exists, and never a reason a claim was refused.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch",
          "bead_id"
        ],
        "properties": {
          "branch": {
            "type": "string"
          },
          "bead_id": {
            "type": "string"
          },
          "bead_status": {
            "type": "string"
          },
          "via": {
            "description": "Why this branch is related to the claim: \"self\" for the claimed bead's own prior attempt, otherwise the label the two beads share.",
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "tip": {
            "type": "string"
          },
          "ahead": {
            "type": "integer"
          },
          "last_commit": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "work"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "bead_id",
          "assignee"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "drain"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "no_work",
              "claims_errored",
              "stale_session"
            ]
          }
        }
      }
    }
  ]
}
